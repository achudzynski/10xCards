---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from "@/components/ui/card";
import { cn } from "@/lib/utils";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4 sm:p-8">
    <Card className="w-full max-w-2xl border-white/10 bg-white/10 text-white backdrop-blur-xl">
      <CardHeader className="text-center">
        <CardTitle
          className="justify-center bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
        >
          Dashboard
        </CardTitle>
        <CardDescription className="text-center text-blue-100/80">
          Welcome back, <span class="font-semibold text-white">{user?.email}</span>. Jump into generating new cards,
          see your existing deck or start a review session.
        </CardDescription>
      </CardHeader>
      <CardContent className="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href="/generate"
          class:list={cn(buttonVariants({ size: "lg" }), "bg-purple-600 text-white hover:bg-purple-500")}
        >
          Generate cards
        </a>
        <a
          href="/deck"
          class:list={cn(
            buttonVariants({ size: "lg", variant: "outline" }),
            "border-white/20 bg-transparent text-white hover:bg-white/10",
          )}
        >
          My deck
        </a>
        <a
          href="/review"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Review
        </a>
      </CardContent>
      <CardFooter className="justify-center border-t border-white/10 pt-6">
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class:list={cn(buttonVariants({ variant: "ghost" }), "text-blue-100/70 hover:bg-white/10 hover:text-white")}
          >
            Sign out
          </button>
        </form>
      </CardFooter>
    </Card>
  </div>
</Layout>
