---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listCards } from "@/lib/services/cards";
import DeckView from "@/components/deck/DeckView";
import type { Card } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let cards: Card[] = [];
let loadError = false;
if (supabase && user) {
  try {
    cards = await listCards(supabase, user.id);
  } catch {
    loadError = true;
  }
}
---

<Layout title="My deck">
  <div class="bg-cosmic min-h-screen p-4 py-12">
    <div class="mx-auto max-w-2xl">
      <div class="mb-8 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          My deck
        </h1>
        <a
          href="/generate"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
        >
          Generate more
        </a>
      </div>

      {
        loadError ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-blue-100/80">We couldn't load your deck right now.</p>
            <p class="mt-2 text-sm text-blue-100/50">Please refresh the page to try again.</p>
          </div>
        ) : (
          <DeckView client:load initialCards={cards} />
        )
      }
    </div>
  </div>
</Layout>
