---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listCards } from "@/lib/services/cards";
import type { Card } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let cards: Card[] = [];
if (supabase && user) {
  cards = await listCards(supabase, user.id);
}
---

<Layout title="My deck">
  <div class="bg-cosmic min-h-screen p-4 py-12">
    <div class="mx-auto max-w-2xl">
      <div class="mb-8 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          My deck
        </h1>
        <a
          href="/generate"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
        >
          Generate more
        </a>
      </div>

      {
        cards.length === 0 ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-blue-100/80">Your deck is empty.</p>
            <p class="mt-2 text-sm text-blue-100/50">
              Head to{" "}
              <a href="/generate" class="underline hover:text-white">
                Generate
              </a>{" "}
              to create your first cards.
            </p>
          </div>
        ) : (
          <ul class="space-y-4">
            {cards.map((card) => (
              <li class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
                <p class="font-semibold">{card.front}</p>
                <p class="mt-2 text-blue-100/80">{card.back}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
