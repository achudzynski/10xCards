{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "10xcards",
  "main": "./dist/server/entry.mjs",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
